# URL of the SUSE AI Universal Proxy
PROXY_URL=http://localhost:8911

# Use -k for self-signed certs; set to "" to disable
CURL_INSECURE=-k

# --- setup.sh variables ---

# SPIRE namespace and server pod
SPIRE_NAMESPACE=spire-system
SPIRE_SERVER_POD=spire-server-0

# Cluster name (arbitrary label for SPIRE)
SPIRE_CLUSTER_NAME=marv

# Trust domain (root of all SPIFFE IDs — choose carefully, permanent)
SPIRE_TRUST_DOMAIN=marv.suse-ai.com

# Proxy workload registration
PROXY_NAMESPACE=suse-ai-up
PROXY_SERVICE_ACCOUNT=suse-ai-up-proxy-sa

# Enable Tornjak web UI (set to "true" to install)
ENABLE_TORNJAK=false

# --- demo.sh variables ---

# Proxy namespace (where mock server is deployed)
PROXY_NAMESPACE=suse-ai-up

# Mock server URL for local testing (demo auto-deploys to cluster)
MOCK_SERVER_URL=http://localhost:8002

# In-cluster URL the proxy uses to reach the mock server
# (auto-derived from PROXY_NAMESPACE if not set)
# MOCK_SERVER_CLUSTER_URL=http://spiffe-mock-server.suse-ai-up.svc.cluster.local:8002

# OAuth token from demo 02 (required for OAuth-enabled proxy)
# Run demo 02 first, then: export AUTH_TOKEN=<token>
# AUTH_TOKEN=
